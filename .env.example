# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# SQLite para desarrollo local sin Docker; PostgreSQL en Docker/Render, p. ej.:
# DATABASE_URL=postgresql+psycopg://usuario:contraseña@host:5432/basedatos
DATABASE_URL=sqlite:///./local.db

# Clave para POST /admin/etl (header X-API-Key). Si está vacía, el endpoint queda deshabilitado.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Orígenes CORS permitidos separados por coma (vacío = CORS desactivado). "*" prohibido en production.
CORS_ORIGINS=

# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO
RATE_LIMIT=60/minute

# Solo para docker-compose
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=